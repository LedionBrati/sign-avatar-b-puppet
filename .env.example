# Flux settings. `npm run setup` copies this to .env; `npm start` reads .env (variables already set in the
# environment win). Everything is optional: with nothing set, Flux runs locally with typed text, the browser's
# speech recognition and the local translator. Every setting is listed in app/server/README.md.

# --- OpenAI (optional) -------------------------------------------------------------------------------------
# Turns on server-side transcription (gpt-4o-mini-transcribe), spoken sentences for sign -> voice, the natural
# voice (gpt-4o-mini-tts) and the planning layer for sentences the local translator can't fully sign.
# Either the key itself or a path to a file holding it. Keys are never logged or returned.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=C:\path\to\openai.key

# --- fal (optional): make missing signs on demand ----------------------------------------------------------
# Needs `npm run setup -- --ondemand` (pipeline packages + the motion library) and Chrome.
# ONDEMAND=on
FAL_KEY=
# FAL_KEY_FILE=C:\path\to\fal.key
# FAL_DAILY_BUDGET_USD=20

# --- Network -----------------------------------------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1          # 0.0.0.0 to reach the app from a phone on the same Wi-Fi (http://<your-LAN-IP>:8787/app/)
# RECOGNIZER_PORT=8788
# NO_RECOGNIZER=1         # skip the Python sign -> voice service

# --- Signing -----------------------------------------------------------------------------------------------
# SIGNING_MODE=strict     # strict: sign a phrase only when every word is signable; relaxed: sign what it can
# CLIPS_DIR=out/realtime/clips,out/realtime/clips-mass,out/realtime/clips-phrases,out/realtime/clips-demo   # the default; first folder wins
# MOTION=off              # turn off the instant 3D signer
