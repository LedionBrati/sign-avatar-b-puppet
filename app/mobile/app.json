{
  "expo": {
    "name": "SIGNLAYER",
    "slug": "signlayer",
    "scheme": "signlayer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1f3fd6",
    "splash": { "backgroundColor": "#1f3fd6", "resizeMode": "contain" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.signlayer.mobile",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "SIGNLAYER turns what people around you say into sign language. Speech is recognised on this device.",
        "NSMicrophoneUsageDescription": "SIGNLAYER listens to speech around you so it can be signed and captioned.",
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true, "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "SIGNLAYER connects to the signing server on your local network."
      }
    },
    "android": {
      "package": "app.signlayer.mobile",
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.INTERNET"],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#1f3fd6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "backgroundColor": "#1f3fd6"
    },
    "plugins": [
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SIGNLAYER listens to speech around you so it can be signed and captioned.",
          "speechRecognitionPermission": "SIGNLAYER turns what people around you say into sign language. Speech is recognised on this device.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-asset"
    ]
  }
}
