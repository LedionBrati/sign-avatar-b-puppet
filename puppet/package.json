{
  "name": "sign-avatar-puppet",
  "private": true,
  "type": "module",
  "description": "Motion JSON (motion/FORMAT.md) -> 2D skeleton debug view + VRM puppet, in the browser and as offline mp4 renders.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixture": "node scripts/make-fixture.mjs",
    "fetch-model": "node fetch-model.mjs",
    "render": "node render.mjs",
    "build:player": "vite build --config vite.player.config.ts"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "kalidokit": "^1.1.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
